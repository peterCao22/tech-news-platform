# 科技新闻聚合平台 - 环境变量模板
# 复制此文件为 .env.local (前端) 和 .env (后端) 并填入实际值

# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/technews"
REDIS_URL="redis://localhost:6379"

# =============================================================================
# 认证配置
# =============================================================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# AI 服务 API 密钥
# =============================================================================
# Google Gemini API 配置
# 方式1: 使用 API Key（简单，适合开发测试）
# 获取地址: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# 方式2: 使用 Vertex AI（推荐用于生产环境）
# 步骤：
# 1. 创建 Google Cloud 项目: https://console.cloud.google.com/
# 2. 启用 Vertex AI API
# 3. 创建服务账号并下载 JSON 密钥文件
# 4. 设置环境变量 GOOGLE_APPLICATION_CREDENTIALS 指向 JSON 文件路径
# GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account-key.json"
GOOGLE_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_LOCATION="us-central1"

# Gemini 模型配置
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_MAX_TOKENS="1000"
GEMINI_TEMPERATURE="0.7"
GEMINI_TIMEOUT="30000"

# Anthropic Claude API
CLAUDE_API_KEY="your-claude-api-key"
CLAUDE_MODEL="claude-3-sonnet-20240229"
CLAUDE_MAX_TOKENS="1000"
CLAUDE_TEMPERATURE="0.7"
CLAUDE_TIMEOUT="30000"

# AI 服务配置
AI_DEFAULT_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="claude"
AI_MAX_RETRIES="3"
AI_RETRY_DELAY_MS="1000"
AI_COST_LIMIT_USD="100.00"
AI_HEALTH_CHECK_INTERVAL_MS="300000"

# =============================================================================
# 金融数据 API 密钥
# =============================================================================
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key"
POLYGON_API_KEY="your-polygon-api-key"
FINNHUB_API_KEY="your-finnhub-api-key"

# =============================================================================
# 自动化工具
# =============================================================================
ZAPIER_API_KEY="your-zapier-api-key"

# =============================================================================
# 应用配置
# =============================================================================
NODE_ENV="development"
LOG_LEVEL="debug"
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# =============================================================================
# AWS 配置 (生产环境)
# =============================================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# =============================================================================
# 监控和日志
# =============================================================================
SENTRY_DSN="your-sentry-dsn"
VERCEL_ANALYTICS_ID="your-vercel-analytics-id"
